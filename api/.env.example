# Which Algorand network this process talks to.
NETWORK=testnet

PORT=4021

# GoPlausible's hosted Algorand x402 facilitator (verified live).
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Address x402 payments settle to (your resource-server payTo address).
PAY_TO_ADDRESS=

# MedRailConsent App ID. Leave unset on testnet to auto-read
# contracts/artifacts/deploy_testnet.json after running the deploy script.
CONSENT_APP_ID=

# Operator (admin) account mnemonic — the same account that deployed the
# contract, or one granted admin via set_admin. Used only to call the
# admin-gated log_access method and to simulate read-only ABI calls.
# NEVER commit this. Generate a dedicated operator account; do not reuse a
# personal wallet.
OPERATOR_MNEMONIC=
OPERATOR_ADDRESS=

# ---------------------------------------------------------------------------
# The autonomous agent demo (scripts/agent-demo.ts) — three separate accounts
# ---------------------------------------------------------------------------
# These exist so the demo settles payments between genuinely independent
# keypairs, rather than the project paying itself. Neither is needed to run the
# service; both are needed to reproduce the run recorded in docs/PROOF.md §10.
#
# Create them with:
#   npx tsx scripts/provision-agent-wallet.ts     # payer: funds ALGO, opts in to USDC, sends $1
#   npx tsx scripts/provision-patient-wallet.ts   # patient: ALGO only — it never pays for anything
#   npx tsx scripts/grant-consent.ts <agentAddress>
#
# Each provisioning script prints its mnemonic once and does NOT write it to
# disk. Paste it here. TestNet play money — but still never commit this file.

# The agent that pays. Falls back to DEPLOYER_MNEMONIC, which makes the run a
# self-payment; scripts/preflight.ts warns when that happens.
AGENT_MNEMONIC=

# The patient who grants access. Signs its own grant/revoke transactions; the
# backend is never in that path.
PATIENT_MNEMONIC=
PATIENT_ADDRESS=
